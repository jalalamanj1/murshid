# ── Murshid Backend environment (owner-side ONLY) ─────────────────────
# Never put these values inside the Electron app. This file is for the
# backend server only. Copy to .env and fill in the values.

# Port the backend listens on.
PORT=8080

# Public base URL used to build share links (no trailing slash).
# Example: https://api.example.com
MURSHID_BASE_URL=http://localhost:8080

# Shared secret between the desktop app and this backend (production only).
# The Electron app sends it in the x-murshid-api-key header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MURSHID_API_KEY=

# JWT signing secret. If left empty, one is generated and persisted once
# to data/secret on first boot.
MURSHID_JWT_SECRET=

# Owner Google Drive folders (keep the defaults unless the folders change).
MURSHID_DRIVE_FOLDER_LETTERS=1U5Fows578m6t9WJNe0HNWYG2m0D6HiDO
MURSHID_DRIVE_FOLDER_FILES=1pNFVBUHEr0pRlo2w2b_r-JIGHdFJYo8I

# Drive access mode. Use one of:
#   service-account  -> GOOGLE_SERVICE_ACCOUNT_* below (recommended)
#   oauth            -> GOOGLE_OAUTH_* below
#   mock             -> local-disk mock (tests / no Google credentials)
# When unset, the mode is inferred from whichever credential is present.
MURSHID_DRIVE_MODE=service-account

# Service account credentials (preferred). Provide exactly ONE:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SERVICE_ACCOUNT_PATH=

# OAuth refresh token (alternative):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Users may delete their own upload only within this window (ms). Default: 1 hour.
MURSHID_DELETE_WINDOW_MS=3600000

# Share links expire after this long (ms). Default: 24 hours.
MURSHID_SHARE_TTL_MS=86400000

# Maximum upload size in bytes (default 50 MB).
MURSHID_MAX_UPLOAD_BYTES=52428800

# Data directory (users, metadata, generated secrets). Default: ./data
# MURSHID_DATA_DIR=
# Local-disk mock drive directory. Default: <dataDir>/mock-drive
# MURSHID_MOCK_DRIVE_DIR=
